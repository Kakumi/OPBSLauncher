<div id="frameBar">
    <div id="frameResizableTop" class="frameDragPadder"></div>
    <div id="frameMain">
        <div class="frameResizableVert frameDragPadder"></div>
        <%if (process.platform === 'darwin') { %>
            <div id="frameContentDarwin">
                <div id="frameButtonDockDarwin">
                    <button class="frameButtonDarwin fCb" id="frameButtonDarwin_close" tabIndex="-1"></button>
                    <button class="frameButtonDarwin fMb" id="frameButtonDarwin_minimize" tabIndex="-1"></button>
                    <button class="frameButtonDarwin fRb" id="frameButtonDarwin_restoredown" tabIndex="-1"></button>
                </div>
                <%- include('frameMusic') %>
                <%- include('frameUpdate') %>
            </div>
        <% } else{ %>
            <div id="frameContentWin">
                <div id="frameTitleDock">
                    <%- include('frameMusic') %>
                </div>
                <%- include('frameUpdate') %>
                <div id="frameButtonDockWin">
                    <button class="frameButton fMb" id="frameButton_minimize" tabIndex="-1">
                        <svg width="12" height="12" viewBox="0 0 12 12"><rect fill="#ffffff" width="10" height="1.4" x="1" y="5.3" rx="0.7"></rect></svg>
                    </button>
                    <button class="frameButton fRb" id="frameButton_restoredown" tabIndex="-1">
                        <svg class="frameIconMaximize" width="12" height="12" viewBox="0 0 12 12"><rect width="9" height="9" x="1.5" y="1.5" rx="1.5" fill="none" stroke="#ffffff" stroke-width="1.4"></rect></svg>
                        <svg class="frameIconRestore" width="12" height="12" viewBox="0 0 12 12"><rect width="7" height="7" x="1.5" y="3.5" rx="1.2" fill="none" stroke="#ffffff" stroke-width="1.4"></rect><path d="M4 3.5V2.7A1.2 1.2 0 0 1 5.2 1.5h4.1a1.2 1.2 0 0 1 1.2 1.2v4.1A1.2 1.2 0 0 1 9.3 8H8.5" fill="none" stroke="#ffffff" stroke-width="1.4"></path></svg>
                    </button>
                    <button class="frameButton fCb" id="frameButton_close" tabIndex="-1">
                        <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 2l8 8M10 2l-8 8" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"></path></svg>
                    </button>
                </div>
            </div>
        <% } %>
        <div class="frameResizableVert frameDragPadder"></div>
    </div>
</div>
